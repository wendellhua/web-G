{
  "name": "void-runner",
  "version": "2.0.0",
  "description": "《黑潮突围（VOID RUNNER）》—— 基于 SDD-G（规格驱动游戏开发）方法论构建的纯前端深空弹幕生存割草游戏（TypeScript + Canvas 2D + Web Audio + Zod）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "html5-game",
    "canvas-2d",
    "roguelike",
    "bullet-heaven",
    "survivors-like",
    "typescript",
    "vite",
    "web-audio",
    "spec-driven-development",
    "sdd",
    "zod",
    "playwright"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint schemas src tests",
    "test:unit": "vitest run tests/unit",
    "test:sim": "vitest run tests/simulation",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:sim && npm run build"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
